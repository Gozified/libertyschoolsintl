---
/**
 * News article shell: base layout + banner image + category/date meta.
 * Mirrors PageLayout's structure but carries article-specific metadata that
 * a plain page header doesn't need (category badge, published date).
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/layout/Breadcrumb.astro';

interface Props {
  title: string;
  description?: string;
  category: string;
  date: Date;
  cover: { src: string; alt: string };
}

const { title, description, category, date, cover } = Astro.props;
---

<BaseLayout title={`${title} | News`} description={description}>
  <div class="page-header">
    <div class="page-header__media" aria-hidden="true">
      <img src={cover.src} alt="" width="1600" height="500" />
    </div>
    <div class="container page-header__inner">
      <Breadcrumb items={[{ label: 'News', href: '/news' }, { label: title }]} />
      <div class="d-flex align-items-center gap-3 mb-2">
        <span class="badge bg-accent text-dark">{category}</span>
        <span class="small" style="color:rgba(255,255,255,.75)">
          <time datetime={date.toISOString()}>
            {date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
        </span>
      </div>
      <h1 class="page-header__title">{title}</h1>
    </div>
  </div>

  <section class="section">
    <div class="container measure mx-auto">
      <div class="prose">
        <slot />
      </div>

      <div class="mt-5">
        <a class="btn btn-outline-primary" href="/news">&larr; Back to News</a>
      </div>
    </div>
  </section>
</BaseLayout>
