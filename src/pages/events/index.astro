---
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const events = (await getCollection('events'))
  .filter((e) => e.data.start >= now)
  .sort((a, b) => a.data.start.valueOf() - b.data.start.valueOf());

const sectionLabels: Record<string, string> = {
  'whole-school': 'Whole School',
  primary: 'Primary',
  secondary: 'Secondary',
};
---

<PageLayout
  title="Events"
  crumbs={[{ label: 'Events' }]}
  standfirst="What's coming up on the Northgate calendar."
  banner="event-prizegiving"
>
  <section class="section">
    <div class="container measure-wide mx-auto">
      <div class="d-flex flex-column gap-3">
        {
          events.map((event) => (
            <div class="card">
              <div class="card-body d-flex gap-4 align-items-start flex-wrap flex-sm-nowrap">
                <span class="date-chip flex-shrink-0">
                  <span class="date-chip__day">
                    {event.data.start.toLocaleDateString('en-GB', { day: '2-digit' })}
                  </span>
                  <span class="date-chip__month">
                    {event.data.start.toLocaleDateString('en-GB', { month: 'short' })}
                  </span>
                </span>
                <div class="flex-grow-1">
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge text-bg-secondary">{sectionLabels[event.data.section]}</span>
                    {!event.data.allDay && (
                      <span class="text-body-secondary small">
                        {event.data.start.toLocaleTimeString('en-GB', { hour: 'numeric', minute: '2-digit' })}
                      </span>
                    )}
                  </div>
                  <h2 class="h5 mb-1">{event.data.title}</h2>
                  {event.data.excerpt && <p class="text-body-secondary mb-1">{event.data.excerpt}</p>}
                  <p class="text-body-secondary small mb-0">{event.data.location}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      {
        events.length === 0 && (
          <p class="text-body-secondary text-center py-5">
            No events scheduled right now — check back soon, or see our{' '}
            <a href="/events/term-dates">Term Dates</a>.
          </p>
        )
      }

      <div class="text-center mt-5">
        <a class="btn btn-outline-primary" href="/events/term-dates">View Term Dates</a>
      </div>
    </div>
  </section>
</PageLayout>
