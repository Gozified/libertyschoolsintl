---
import PageLayout from '../../layouts/PageLayout.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import { site } from '../../data/site';

const feeTable = [
  { level: 'Nursery & Reception', termFee: '₦XXX,XXX', registration: '₦XX,XXX' },
  { level: 'Primary 1 – 3', termFee: '₦XXX,XXX', registration: '₦XX,XXX' },
  { level: 'Primary 4 – 6', termFee: '₦XXX,XXX', registration: '₦XX,XXX' },
  { level: 'Junior Secondary (JSS 1–3)', termFee: '₦XXX,XXX', registration: '₦XX,XXX' },
  { level: 'Senior Secondary (SSS 1–3)', termFee: '₦XXX,XXX', registration: '₦XX,XXX' },
];
---

<PageLayout
  title="Fees | Admissions"
  crumbs={[{ label: 'Admissions', href: '/admissions' }, { label: 'Fees' }]}
  standfirst="An illustrative view of our fee structure. Final figures are confirmed at enrolment."
>
  <section class="section">
    <div class="container measure-wide mx-auto">
      <div class="alert alert-warning" role="note">
        <strong>Placeholder figures.</strong> The amounts below are illustrative only and must not
        be treated as current pricing. Contact <a href={`mailto:${site.contact.admissionsEmail}`}>{site.contact.admissionsEmail}</a>
        for confirmed, up-to-date fees.
      </div>

      <div class="table-responsive">
        <table class="table align-middle">
          <thead>
            <tr>
              <th scope="col">Level</th>
              <th scope="col">Fee per term</th>
              <th scope="col">One-off registration</th>
            </tr>
          </thead>
          <tbody>
            {
              feeTable.map((row) => (
                <tr>
                  <th scope="row" class="fw-normal">{row.level}</th>
                  <td>{row.termFee}</td>
                  <td>{row.registration}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="prose mt-4">
        <p>
          Fees are billed termly and typically cover tuition, core textbooks, and standard
          co-curricular activities. They do not usually include uniform, transport, meals (where
          not already bundled), or optional trips — these are itemised separately at enrolment.
        </p>
        <p>
          Sibling discounts and needs-based bursaries may be available; ask our admissions team
          for details.
        </p>
      </div>

      <div class="text-center mt-4">
        <a class="btn btn-primary" href="/admissions/enquire">Ask About Fees</a>
      </div>
    </div>
  </section>
</PageLayout>
