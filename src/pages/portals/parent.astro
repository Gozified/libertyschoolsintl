---
import PageLayout from '../../layouts/PageLayout.astro';
import { site } from '../../data/site';
import { Icon } from 'astro-icon/components';
---

<PageLayout
  title="Parent Portal"
  crumbs={[{ label: 'Parent Portal' }]}
  standfirst="Reports, payments and communication for Northgate parents and guardians."
>
  <section class="section">
    <div class="container measure mx-auto">
      <div class="rounded-2 p-4 p-md-5 text-center" style="background:var(--nga-tint);">
        <Icon name="lucide:users" width="40" height="40" aria-hidden="true" style="color:var(--nga-accent-strong)" />
        <h2 class="h4 mt-3">Not yet connected</h2>
        <p class="text-body-secondary mx-auto" style="max-width:32rem;">
          The Parent Portal isn't wired up to a live login system yet. This is a placeholder page
          — once the school confirms which system it uses for fees and reporting, this page will
          link straight to it.
        </p>
      </div>

      <div class="prose mt-5">
        <h2>What the Parent Portal will offer</h2>
        <ul>
          <li>Termly report cards and progress updates</li>
          <li>Fee statements and online payment</li>
          <li>Direct messaging with class teachers</li>
          <li>School calendar and event sign-ups</li>
        </ul>
      </div>

      <div class="text-center mt-4">
        <p class="mb-3">Need to make a payment or check something now?</p>
        <a class="btn btn-primary" href="/contact">Contact the School Office</a>
      </div>
    </div>
  </section>
</PageLayout>
