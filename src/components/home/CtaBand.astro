---
/**
 * Call-to-action band — testimonial + primary CTA.
 * Sits above the footer on the homepage.
 */
---

<section class="section-tight section-ink">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-8">
        <blockquote class="mb-0">
          <p class="lead mb-3 measure">
            "Northgate feels like a genuine community where my child is known and valued.
            The teachers really care, and the academics are rigorous without being
            pressure-cooker."
          </p>
          <footer class="text-body-secondary">
            <cite style="font-style:normal">
              Parent of two, Primary and Secondary
            </cite>
          </footer>
        </blockquote>
      </div>

      <div class="col-lg-4 text-lg-end">
        <p class="mb-3" style="color:rgba(255,255,255,.78)">
          Ready to learn more? Visit us or request information about admissions.
        </p>
        <div class="d-flex flex-column gap-2">
          <a class="btn btn-accent btn-lg" href="/admissions/enquire">Make an Enquiry</a>
          <a class="btn btn-on-ink btn-lg" href="/contact">Get in Touch</a>
        </div>
      </div>
    </div>
  </div>
</section>
