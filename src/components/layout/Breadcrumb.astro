---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/">Home</a></li>
    {
      items.map((item, i) => {
        const isLast = i === items.length - 1;
        return (
          <li class:list={['breadcrumb-item', { active: isLast }]} aria-current={isLast ? 'page' : undefined}>
            {isLast || !item.href ? item.label : <a href={item.href}>{item.label}</a>}
          </li>
        );
      })
    }
  </ol>
</nav>
