---
/**
 * Brand lockup. Uses a generated monogram mark until a real logo is supplied —
 * drop the file at public/img/logo.svg and swap the <svg> below for an <img>.
 */
import { site } from '../../data/site';

interface Props {
  /** Inverted colours for use on the dark footer. */
  onDark?: boolean;
  href?: string;
}

const { onDark = false, href = '/' } = Astro.props;
const initials = site.shortName.slice(0, 1);
const markFill = onDark ? '#ffffff' : '#1e3a6b';
const markText = onDark ? '#0f1d3d' : '#ffffff';
---

<a class="brand" href={href} aria-label={`${site.name} — home`}>
  <!-- PLACEHOLDER MARK: replace with the school's real logo -->
  <svg
    class="brand__mark"
    viewBox="0 0 44 44"
    width="44"
    height="44"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M22 1 41 9v14c0 9.4-7.6 16.7-19 20C10.6 39.7 3 32.4 3 23V9L22 1Z" fill={markFill} />
    <text
      x="22"
      y="27.5"
      text-anchor="middle"
      font-family="Georgia, serif"
      font-size="17"
      font-weight="700"
      fill={markText}>{initials}</text
    >
  </svg>
  <span>
    <span class="brand__name" style={onDark ? 'color:#fff' : undefined}>{site.name}</span>
    <span class="brand__tag" style={onDark ? 'color:rgba(255,255,255,.7)' : undefined}
      >{site.tagline}</span
    >
  </span>
</a>
