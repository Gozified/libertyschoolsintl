---
import { Icon } from 'astro-icon/components';
import { site, currentYear, activeSocial } from '../../data/site';
import { footerNav, legalNav } from '../../data/nav';
import Brand from './Brand.astro';

/** Icon per network, so the footer never renders an unlabelled generic link. */
const socialIcons: Record<string, string> = {
  facebook: 'lucide:facebook',
  instagram: 'lucide:instagram',
  x: 'lucide:twitter',
  linkedin: 'lucide:linkedin',
  youtube: 'lucide:youtube',
};

const socialLabels: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  x: 'X',
  linkedin: 'LinkedIn',
  youtube: 'YouTube',
};
---

<footer class="site-footer">
  <div class="container py-6">
    <div class="row g-5">
      <div class="col-lg-4">
        <Brand onDark />
        <p class="mt-3 mb-4 measure-narrow">{site.description}</p>

        <!--
          Social icons render only for networks with a real URL in site.ts.
          The previous build shipped 52 dead href="#" social links.
        -->
        {
          activeSocial.length > 0 && (
            <ul class="site-footer__social list-unstyled d-flex gap-2 mb-0">
              {activeSocial.map(({ network, url }) => (
                <li>
                  <a href={url} rel="me noopener" target="_blank">
                    <Icon name={socialIcons[network] ?? 'lucide:link'} width="18" height="18" />
                    <span class="visually-hidden">
                      {socialLabels[network] ?? network} (opens in a new tab)
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        footerNav.map((column) => (
          <div class="col-6 col-lg-2">
            <h2 class="footer-heading">{column.heading}</h2>
            <ul class="site-footer__list">
              {column.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="col-12 col-lg-2">
        <h2 class="footer-heading">Get in Touch</h2>
        <address class="mb-3" style="font-style:normal">
          {site.contact.addressLines.map((line) => <span class="d-block">{line}</span>)}
        </address>
        <ul class="site-footer__list">
          <li>
            <a href={`tel:${site.contact.phone.href}`}>{site.contact.phone.display}</a>
          </li>
          <li>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
        </ul>
        <p class="mt-3 mb-0 small" style="color:rgba(255,255,255,.55)">
          {site.contact.officeHours}
        </p>
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div
      class="container py-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2"
    >
      <p class="mb-0">&copy; {currentYear} {site.name}. All rights reserved.</p>
      <ul class="nav gap-3 mb-0">
        {
          legalNav.map((link) => (
            <li class="nav-item">
              <a class="p-0" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
